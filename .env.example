# Discord Configuration
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
DEFAULT_PREFIX=!

# Web & Dashboard
PORT=3000
DASHBOARD_URL=https://unnuke.lightsout.in

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/chronosrestore?schema=public

# Queue & Background Jobs (Redis)
REDIS_URL=redis://localhost:6379

# Security (AES-256-GCM Encryption Key - MUST be 32 bytes/64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
