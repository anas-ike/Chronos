<%- include('../partials/header') %>

<div class="content-wrapper">
    <div class="content-header">
        <div class="container">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Backup Inspector</h1>
                    <p class="text-muted">ID: <code><%= backup.id %></code> | Taken: <%= backup.created_at.toUTCString() %></p>
                </div>
                <div class="col-sm-6 text-right">
                    <a href="/dashboard/<%= userGuild.id %>" class="btn btn-secondary mr-2">Back to Server</a>
                    <% if (isOwner) { %>
                        <button class="btn btn-danger mr-2" data-toggle="modal" data-target="#deleteModal">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <button class="btn btn-warning" data-toggle="modal" data-target="#restoreModal">
                            <i class="fas fa-exclamation-triangle"></i> Restore (Unnuke)
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container">
            <div class="row">
                <!-- Settings & Roles -->
                <div class="col-md-4">
                    <div class="card card-dark">
                        <div class="card-header"><h3 class="card-title">Server Settings</h3></div>
                        <div class="card-body">
                            <strong><i class="fas fa-signature mr-1"></i> Name</strong>
                            <p class="text-muted"><%= backup.server_name %></p>
                            <hr style="border-top: 1px solid #1a1a1a;">
                            <strong><i class="fas fa-shield-alt mr-1"></i> Verification Level</strong>
                            <p class="text-muted"><%= backup.server_settings.verificationLevel %></p>
                            <hr style="border-top: 1px solid #1a1a1a;">
                            <strong><i class="fas fa-image mr-1"></i> Assets</strong>
                            <div class="mt-2">
                                <% if (backup.server_icon_url) { %>
                                    <img src="<%= backup.server_icon_url %>" class="img-thumbnail bg-dark border-secondary mr-2" width="64" alt="Icon">
                                <% } %>
                                <% if (backup.server_banner_url) { %>
                                    <img src="<%= backup.server_banner_url %>" class="img-thumbnail bg-dark border-secondary" height="64" alt="Banner">
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="card card-dark">
                        <div class="card-header"><h3 class="card-title">Roles (<%= backup.roles.length %>)</h3></div>
                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <ul class="list-group list-group-flush">
                                <% backup.roles.forEach(role => { %>
                                    <li class="list-group-item bg-transparent" style="border-color: #1a1a1a;">
                                        <span style="color: #<%= role.color.toString(16).padStart(6, '0') %>">●</span> 
                                        <%= role.name %> 
                                        <span class="float-right text-muted text-sm">Pos: <%= role.position %></span>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Channels -->
                <div class="col-md-8">
                    <div class="card card-dark">
                        <div class="card-header"><h3 class="card-title">Channel Layout (<%= backup.channels.length %>)</h3></div>
                        <div class="card-body bg-black" style="max-height: 800px; overflow-y: auto; padding-left: 25px;">
                            <!-- Uncategorized Channels First -->
                            <% channelMap.get('Uncategorized').forEach(ch => { %>
                                <div class="py-1">
                                    <i class="fas fa-hashtag text-muted mr-2"></i> <%= ch.name %>
                                </div>
                            <% }) %>

                            <!-- Categories and their children -->
                            <% categories.forEach(cat => { %>
                                <div class="mt-3 mb-1 font-weight-bold text-uppercase text-muted">
                                    <i class="fas fa-folder-open mr-2"></i> <%= cat.name %>
                                </div>
                                <div style="margin-left: 20px;">
                                    <% channelMap.get(cat.name).forEach(ch => { %>
                                        <div class="py-1">
                                            <% if (ch.type === 'voice' || ch.type === 'stage') { %>
                                                <i class="fas fa-volume-up text-muted mr-2"></i>
                                            <% } else { %>
                                                <i class="fas fa-hashtag text-muted mr-2"></i>
                                            <% } %>
                                            <%= ch.name %>
                                        </div>
                                    <% }) %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RESTORE MODAL -->
<div class="modal fade" id="restoreModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-dark">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-warning"><i class="fas fa-exclamation-triangle"></i> Configure Restoration Scope</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p>Select what to restore. This will <strong>DELETE</strong> current live server assets in the selected categories and replace them with the backup data.</p>
                
                <div class="form-group">
                    <label>Restoration Scopes</label>
                    <select class="form-control bg-black text-white border-secondary" id="restoreScopes" multiple style="height: 150px;">
                        <option value="all" class="text-danger font-weight-bold">⚠️ Unnuke All (Top Priority - Restores Everything)</option>
                        <option value="channels">Channels & Categories</option>
                        <option value="roles">Roles</option>
                        <option value="settings">Server Settings</option>
                        <option value="bans">Bans (Sync List)</option>
                        <option value="members">Members (Re-invite Verified Users)</option>
                    </select>
                    <small class="form-text text-muted">Hold CTRL/CMD to select multiple specific scopes, or just select Unnuke All.</small>
                </div>

                <div class="form-group mt-4">
                    <label class="text-danger">Type "CONFIRM" or "<%= userGuild.name %>" to proceed:</label>
                    <input type="text" class="form-control bg-black text-white border-secondary" id="restoreConfirmText">
                </div>
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="executeRestore()">Initiate Unnuke</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content bg-dark">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-danger"><i class="fas fa-trash"></i> Delete Backup</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p>This is a permanent, irreversible action.</p>
                <div class="form-group">
                    <label class="text-danger">Type "<%= userGuild.name %>" or the Backup ID to confirm:</label>
                    <input type="text" class="form-control bg-black text-white border-secondary" id="deleteConfirmText">
                </div>
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="executeDelete()">Delete Permanently</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const guildId = '<%= userGuild.id %>';
    const backupId = '<%= backup.id %>';

    async function executeRestore() {
        const scopesOptions = document.getElementById('restoreScopes').selectedOptions;
        const scopes = Array.from(scopesOptions).map(opt => opt.value);
        const confirmText = document.getElementById('restoreConfirmText').value.trim();

        if (scopes.length === 0) return alert('You must select at least one scope.');
        if (!confirmText) return alert('You must type the confirmation text.');

        try {
            const res = await fetch(`/api/dashboard/${guildId}/restore`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ backupId, scopes, confirmText })
            });
            const data = await res.json();

            if (data.success) {
                alert('Restoration job queued in the background! Redirecting to dashboard...');
                window.location.href = `/dashboard/${guildId}`;
            } else {
                alert('Error: ' + data.error);
            }
        } catch (e) {
            alert('Failed to connect to the server.');
        }
    }

    async function executeDelete() {
        const confirmText = document.getElementById('deleteConfirmText').value.trim();
        if (!confirmText) return alert('You must type the confirmation text.');

        try {
            const res = await fetch(`/api/dashboard/${guildId}/backup/${backupId}/delete`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ confirmText })
            });
            const data = await res.json();

            if (data.success) {
                alert('Backup deleted successfully.');
                window.location.href = `/dashboard/${guildId}`;
            } else {
                alert('Error: ' + data.error);
            }
        } catch (e) {
            alert('Failed to connect to the server.');
        }
    }
</script>
</body>
</html>
