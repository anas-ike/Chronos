<%- include('../partials/header') %>

<div class="content-wrapper">
    <div class="content-header">
        <div class="container">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Server Settings <small class="text-muted"><%= userGuild.name %></small></h1>
                </div>
                <div class="col-sm-6 text-right">
                    <a href="/dashboard/<%= userGuild.id %>" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <!-- Success Alert -->
                    <script>
                        const urlParams = new URLSearchParams(window.location.search);
                        if(urlParams.has('success')) {
                            document.write(`
                            <div class="alert alert-success alert-dismissible">
                                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                                <h5><i class="icon fas fa-check"></i> Success!</h5>
                                Settings have been saved successfully.
                            </div>`);
                        }
                    </script>

                    <div class="card card-dark">
                        <div class="card-header border-0">
                            <h3 class="card-title"><i class="fas fa-cogs"></i> Configuration</h3>
                        </div>
                        <form action="/dashboard/<%= userGuild.id %>/settings" method="POST">
                            <div class="card-body bg-black">
                                <div class="form-group">
                                    <label>Automated Backup Frequency</label>
                                    <select name="backup_frequency" class="form-control bg-dark text-white border-secondary">
                                        <option value="manual" <%= guildData.backup_frequency === 'manual' ? 'selected' : '' %>>Manual Only (Disabled)</option>
                                        <option value="daily" <%= guildData.backup_frequency === 'daily' ? 'selected' : '' %>>Daily (Every 24 Hours)</option>
                                        <option value="weekly" <%= guildData.backup_frequency === 'weekly' ? 'selected' : '' %>>Weekly (Every 7 Days)</option>
                                    </select>
                                </div>

                                <div class="form-group mt-4">
                                    <label>Unnuke Cooldown Limit</label>
                                    <select name="unnuke_cooldown_hours" class="form-control bg-dark text-white border-secondary">
                                        <option value="24" <%= guildData.unnuke_cooldown_hours === 24 ? 'selected' : '' %>>24 Hours (Default)</option>
                                        <option value="36" <%= guildData.unnuke_cooldown_hours === 36 ? 'selected' : '' %>>36 Hours</option>
                                        <option value="48" <%= guildData.unnuke_cooldown_hours === 48 ? 'selected' : '' %>>48 Hours</option>
                                    </select>
                                    <small class="text-muted">How long an owner must wait between triggering full restorations.</small>
                                </div>

                                <hr style="border-top: 1px solid #1a1a1a;" class="my-4">

                                <div class="form-group">
                                    <label>Backup Log Channel ID</label>
                                    <input type="text" name="backup_channel_id" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 123456789012345678" value="<%= guildData.backup_channel_id || '' %>">
                                    <small class="text-muted">The channel where the bot will post successful backup completion summaries.</small>
                                </div>

                                <div class="form-group">
                                    <label>Verify Panel Channel ID</label>
                                    <input type="text" name="verify_channel_id" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 123456789012345678" value="<%= guildData.verify_channel_id || '' %>">
                                </div>

                                <div class="form-group">
                                    <label>Verified Member Role ID</label>
                                    <input type="text" name="verify_role_id" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 123456789012345678" value="<%= guildData.verify_role_id || '' %>">
                                    <small class="text-muted">The role to automatically assign to users once they complete OAuth verification.</small>
                                </div>
                            </div>
                            <div class="card-footer bg-dark border-top border-secondary">
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
