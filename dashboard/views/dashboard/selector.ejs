<%- include('../partials/header') %>

<div class="content-wrapper">
    <div class="content-header">
        <div class="container">
            <h1 class="m-0">Select a Server</h1>
        </div>
    </div>

    <div class="content">
        <div class="container">
            <h4 class="mt-4 mb-3">Active Servers</h4>
            <div class="row">
                <% if (readyGuilds.length === 0) { %>
                    <div class="col-12"><p class="text-muted">You have no active servers using ChronosRestore.</p></div>
                <% } else { %>
                    <% readyGuilds.forEach(guild => { %>
                        <div class="col-md-4 col-sm-6 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <% if (guild.icon) { %>
                                        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" class="img-circle elevation-2 mb-3" width="80" alt="Icon">
                                    <% } else { %>
                                        <div class="img-circle elevation-2 mb-3 d-inline-flex align-items-center justify-content-center bg-dark" style="width: 80px; height: 80px; font-size: 24px;">
                                            <%= guild.name.charAt(0) %>
                                        </div>
                                    <% } %>
                                    <h5 class="card-title w-100"><%= guild.name %></h5>
                                    <a href="/dashboard/<%= guild.id %>" class="btn btn-primary mt-3 w-100">Manage</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <h4 class="mt-5 mb-3 text-muted">Invite Required</h4>
            <div class="row">
                <% pendingGuilds.forEach(guild => { %>
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card" style="opacity: 0.6;">
                            <div class="card-body text-center">
                                <h6 class="text-truncate"><%= guild.name %></h6>
                                <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>" target="_blank" class="btn btn-outline-light btn-sm mt-2">Invite Bot</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
